<?xml version="1.0"?>
<robot name="my_robot">

<material name = "white">
	<color rgba="1 1 1 1" />
</material>

<link name="base_link">
	<visual>
		<geometry>
			<box size="0.6 0.4 0.2" />
		</geometry>
		<origin xyz="0 0 0.1" rpy="0 0 0"/>
	</visual>
</link>

<link name="wheel">
	<visual>
		<geometry>
			<cylinder radius="0.1" length="0.1" />
		</geometry>
		<origin xyz="0 0 0.25" rpy="0 0 0"/>
		<material name="white"/>
	</visual>
</link>

<joint name="base_wheel_joint" type="continuous">
	<parent link = "base_link"/>
	<child link = "wheel" />
	<origin xyz = "0 0 0" rpy = "0 0 0" />  
</joint>

</robot>
